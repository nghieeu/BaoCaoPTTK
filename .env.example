# Optional: copy to .env and run: node --env-file=.env server.cjs
HOST=127.0.0.1
PORT=3000
RESTMAN_DB=data/restman.sqlite
# Only used when initializing a new database; does not reset existing passwords.
RESTMAN_INITIAL_PASSWORD=RestMan@12345
RESTMAN_DEMO_DATA=1
# Set to 1 only behind HTTPS; set ORIGIN to the exact browser origin if needed.
RESTMAN_SECURE_COOKIE=0
